# ==============================================================================
# gh-green Configuration Template
# ==============================================================================
# Copy this file to .env and configure your repository and token details:
#   cp .env.example .env
# ==============================================================================

# [REQUIRED] GitHub Personal Access Token (PAT)
# Recommended: Fine-grained token with "Contents: Read and write" permission
# Classic tokens require 'repo' scope.
GH_TOKEN=github_pat_11AXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [REQUIRED] GitHub repository owner (username or organization name)
GH_OWNER=your-username

# [REQUIRED] Target repository name
GH_REPO=your-repository-name

# [OPTIONAL] Target branch to commit changes to
# Default: main
GH_BRANCH=main

# [OPTIONAL] File path inside the repository to update
# Kept as valid Go code so GitHub Linguist recognizes repository as 100% Go.
# Default: internal/telemetry/state.go
GH_TARGET_FILE=internal/telemetry/state.go

# [OPTIONAL] Probability (0 - 100%) to skip commits today
# Simulates natural human behavior (weekends, off-days, vacations).
# Set to 0 to disable skipping entirely.
# Default: 15
SKIP_PROBABILITY=15

# [OPTIONAL] Maximum number of commits per execution session (1 - MAX_COMMITS)
# When run normally, a random number between 1 and MAX_COMMITS will be chosen.
# Default: 5
MAX_COMMITS=5

# [OPTIONAL] Maximum random initial delay (jitter) in minutes before starting commits
# Prevents bot detection by avoiding committing at exact same cron minutes every day.
# Default: 90
MAX_JITTER_MINUTES=90

